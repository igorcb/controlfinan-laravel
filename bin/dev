#!/bin/sh
# Development: install dependencies, build and watch the CSS, migrate and serve.
set -e
composer install --no-interaction --quiet
tailwindcss -i resources/css/app.css -o public/css/app.css
tailwindcss -i resources/css/app.css -o public/css/app.css --watch=always &
php artisan migrate --force
exec php artisan serve --host=0.0.0.0 --port=8000
